# Astro self-hosted — copy to `.env` and fill in. Generate secrets with: openssl rand -hex 32

# ── Release (provided by Astro with your registry credentials) ──
ASTRO_REGISTRY=registry.astro.app
ASTRO_CUSTOMER=
ASTRO_VERSION=

# ── License (optional here: it can be installed from Administration → Licence) ──
ASTRO_LICENSE_KEY=

# ── Domains (DNS records must point at this server; they are built into the web image) ──
APP_DOMAIN=astro.example.com
FILES_DOMAIN=files.astro.example.com
ACME_EMAIL=it@example.com

# ── Database / object storage / cache ──
POSTGRES_USER=astro
POSTGRES_PASSWORD=
MINIO_ROOT_USER=astro
MINIO_ROOT_PASSWORD=
MINIO_APP_ACCESS_KEY=astro-app
MINIO_APP_SECRET_KEY=
REDIS_PASSWORD=                # hex only (it is embedded in REDIS_URL)

# ── Auth / crypto (never change APP_ENCRYPTION_KEY after the first start) ──
JWT_ACCESS_SECRET=
APP_ENCRYPTION_KEY=

# ── Mail ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=astro@example.com

# ── Backups (mandatory passphrase — keep a copy outside this server) ──
BACKUP_ENCRYPTION_PASSPHRASE=
# BACKUP_S3_ENDPOINT= / BACKUP_S3_ACCESS_KEY= / BACKUP_S3_SECRET_KEY= / BACKUP_S3_BUCKET=

# ── Scale ──
API_REPLICAS=2
