    {
      "id": "4ACM0xhdns3-YNmSjgQpR",
      "type": "text",
      "x": 700,
      "y": 0,
      "width": 249.7192840576172,
      "height": 30,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
