      "seed": 2055234602,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793492411506,
      "link": null,
      "locked": false,
      "text": "Read it geometrically",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 21,
      "containerId": null,
      "originalText": "Read it geometrically",
      "lineHeight": 1.25
    },
    {
      "id": "osibX4ckFZajK8EnC-4gG",
      "type": "text",
      "x": 700,
      "y": 50,
      "width": 342.3446044921875,
      "height": 202.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 927386486,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793492411510,
      "link": null,
      "locked": false,
      "text": "1.  Nearest search on all 5 dims\n     picks 8 candidates (circles).\n\n2.  Drop them onto the d0–d4 plane.\n     Score = q₀·x + q₄·y: how far each\n     point reaches along q.\n\n3.  Keep the 3 that reach furthest\n     (filled, numbered).",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 195,
      "containerId": null,
      "originalText": "1.  Nearest search on all 5 dims\n     picks 8 candidates (circles).\n\n2.  Drop them onto the d0–d4 plane.\n     Score = q₀·x + q₄·y: how far each\n     point reaches along q.\n\n3.  Keep the 3 that reach furthest\n     (filled, numbered).",
      "lineHeight": 1.25
    },
    {
      "id": "E4HB5BJVGcqPtIza1Pg3a",
      "type": "text",
      "x": 700,
      "y": 320,
      "width": 304.5579833984375,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1576423146,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793492411511,
      "link": null,
      "locked": false,
      "text": "Lines at right angles to q are\nequal-score lines: everything above\nthe dashed one beats result 3.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 60,
      "containerId": null,
      "originalText": "Lines at right angles to q are\nequal-score lines: everything above\nthe dashed one beats result 3.",
      "lineHeight": 1.25
    },
    {
      "id": "OE_NQTkF359fbxsKQ6FpB",
      "type": "text",
      "x": 700,
      "y": 430,
      "width": 288.5380859375,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1586097334,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793492411511,
      "link": null,
      "locked": false,
      "text": "Points above it that were never\ncandidates are missed: raise\ncandidates_limit to catch them.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 60,
      "containerId": null,
      "originalText": "Points above it that were never\ncandidates are missed: raise\ncandidates_limit to catch them.",
      "lineHeight": 1.25
    },
