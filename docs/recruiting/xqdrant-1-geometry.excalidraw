      "link": null,
      "locked": false,
      "text": "q and v span a box. Each edge\nis one axis; the square on it\nis that term. The squares add\nup to the diagonal squared.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 79,
      "containerId": null,
      "originalText": "q and v span a box. Each edge\nis one axis; the square on it\nis that term. The squares add\nup to the diagonal squared.",
      "lineHeight": 1.25
    },
