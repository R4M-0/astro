      "boundElements": null,
      "updated": 1793492411161,
      "link": null,
      "locked": false,
      "text": "Walk v one axis at a time.\nEach step casts a shadow on q;\nterm = |q| × that shadow.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 58,
      "containerId": null,
      "originalText": "Walk v one axis at a time.\nEach step casts a shadow on q;\nterm = |q| × that shadow.",
      "lineHeight": 1.25
    },
    {
      "id": "93v9sBTQFv-FOT3YmDypW",
      "type": "text",
      "x": 420,
      "y": 320,
      "width": 279.1053771972656,
      "height": 63.75,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1448372906,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793492411163,
      "link": null,
      "locked": false,
      "text": "The d2 step points away from q:\nits shadow runs backwards,\nso the term is negative.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 58,
      "containerId": null,
      "originalText": "The d2 step points away from q:\nits shadow runs backwards,\nso the term is negative.",
      "lineHeight": 1.25
    },
