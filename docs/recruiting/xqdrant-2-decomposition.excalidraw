    {
      "id": "EKiAtgkdZUORV62FXerQ5",
      "type": "text",
      "x": 800,
      "y": 40,
      "width": 336.9398193359375,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 262586218,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793492411419,
      "link": null,
      "locked": false,
      "text": "A step right: q and v agree on that\ndim and the score rises. A step left:\nthey disagree and it falls. The top 3\nare the longest steps, either way.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 83,
      "containerId": null,
      "originalText": "A step right: q and v agree on that\ndim and the score rises. A step left:\nthey disagree and it falls. The top 3\nare the longest steps, either way.",
      "lineHeight": 1.25
    },
    {
      "id": "tgL0EUD4NkRc6YNCdyeWU",
      "type": "text",
      "x": 800,
      "y": 250,
      "width": 266.07427978515625,
      "height": 45,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 850838582,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793492411420,
      "link": null,
      "locked": false,
      "text": "Grey steps are not returned,\nbut they still move the score.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 38,
      "containerId": null,
      "originalText": "Grey steps are not returned,\nbut they still move the score.",
      "lineHeight": 1.25
    },
