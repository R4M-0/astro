# Production secrets for docker-compose.prod.yml — copy to `.env` and fill in.
# Generate secrets with: openssl rand -hex 32

# ── Domains (DNS A/AAAA records must point at this server before first start) ──
APP_DOMAIN=app.example.com
FILES_DOMAIN=files.example.com
ACME_EMAIL=ops@example.com

# ── Database / object storage ──
POSTGRES_USER=astro
POSTGRES_PASSWORD=
MINIO_ROOT_USER=astro
MINIO_ROOT_PASSWORD=           # root: used only by minio, minio-init and backup
# bucket-scoped user the api/worker use (created by the minio-init service)
MINIO_APP_ACCESS_KEY=astro-app
MINIO_APP_SECRET_KEY=
REDIS_PASSWORD=                # hex only (it is embedded in REDIS_URL)
# MINIO_DATA_DIR=/mnt/volume/minio   # use Local Block Storage for uploaded files

# ── Auth / crypto ──
JWT_ACCESS_SECRET=
APP_ENCRYPTION_KEY=
# first super admin (seed) — required in production, no default password
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Self-hosted licensing (docs/selfhosting.md) ──
# base64 of license-signing.key from `pnpm --filter @astro/api license keygen` — empty = issuing disabled
LICENSE_SIGNING_KEY=

# ── Mail ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ── Scale (defaults fit 8 cores / 16 GB) ──
API_REPLICAS=5
WEB_REPLICAS=1
DB_POOL_PER_REPLICA=15
# TRUST_PROXY=2   # only if a Cloudflare tunnel/CDN sits in front of Caddy

# ── Backups — without an off-box target, a disk failure loses everything ──
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=7
BACKUP_S3_ENDPOINT=          # e.g. https://fsn1.your-objectstorage.com
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=astro-backups
BACKUP_REMOTE_KEEP_DAYS=30
BACKUP_FILES_MODE=sse-c       # sse-c = encrypted incremental mirror; tar = nightly encrypted archive (provider without SSE-C)
BACKUP_ENCRYPTION_PASSPHRASE=  # REQUIRED — encrypts local dumps and off-box copies; store it outside this server, needed to restore
