DATABASE_URL=postgresql://astro:astro@localhost:5434/astro
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=change-me-access
# 32-byte key (64 hex chars) used to encrypt TOTP secrets at rest; derived from JWT_ACCESS_SECRET when unset
# APP_ENCRYPTION_KEY=
# Reverse-proxy hops to trust for client IPs (default 1 in production, 0 otherwise).
# 1 = Caddy only; set 2 when a CDN/Cloudflare sits in front of Caddy (Cloudflare → Caddy → API),
# otherwise rate limits and audit-log IPs see the CDN edge address.
# TRUST_PROXY=1
# Swagger is disabled in production unless SWAGGER_ENABLED=true
# Seeding: SUPER_ADMIN_EMAIL / SUPER_ADMIN_PASSWORD (required in production), SEED_DEMO=true to force the demo org
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY=astro
S3_SECRET_KEY=astro-secret
S3_BUCKET=astro
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_FROM=noreply@astro.app
# ALLOW_ORG_CREATION=true / MAX_ORGS_PER_USER=3 — self-serve organization creation
# PUBLIC_FEEDBACK_TTL_DAYS=365 — training feedback share links expire after this
APP_URL=http://localhost:3010

# Recruiting pipeline 1 (docs/recruiting): Claude extracts/judges, OpenAI embeds, XQdrant retrieves
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XQDRANT_URL=http://localhost:6343
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
API_PORT=3011

# Scaling (defaults suit single-process dev)
# APP_ROLE=all              # api | worker | all — prod runs N×api + 1×worker
# RATE_LIMIT_PER_MIN=300    # global per-IP limit; raise only for load tests
# AUTH_CACHE=on             # off disables the per-process auth-context cache
# ORG_CACHE=on              # off disables the per-organization read cache (dashboards)
# API_HOST=127.0.0.1        # bind address; unset = all interfaces
# IMPERSONATION_TTL=1800    # seconds a super-admin impersonation token stays valid
# S3_PUBLIC_ENDPOINT=       # browser-facing MinIO URL when S3_ENDPOINT is internal

# Public deployment (NODE_ENV=production OR APP_URL https): the API refuses to boot with the dev
# S3 keys, without APP_ENCRYPTION_KEY, or while superadmin/demo admin accept a documented default
# password. Swagger is off there unless SWAGGER_ENABLED=true (SWAGGER_ENABLED=false hides it locally).
# SWAGGER_ENABLED=

# Self-hosted licensing (see docs/08 §12). Protected images (Dockerfile.selfhosted) are always
# self-hosted and embed their public key; these variables only matter for unbundled runs.
# DEPLOYMENT_MODE=saas      # self-hosted → license enforced, no platform/billing routes
# LICENSE_PUBLIC_KEY=       # PEM or base64 PEM (unbundled self-hosted runs only)
# LICENSE_FILE=/etc/astro/license.lic
# LICENSE_KEY=              # QLIC1.… alternative to the file / Admin → Licence upload
# SaaS only — signs licenses at /platform/licenses (never put it in a self-hosted image)
# LICENSE_SIGNING_KEY=      # Ed25519 private key, PEM or base64 PEM (`pnpm --filter @astro/api license keygen`)
