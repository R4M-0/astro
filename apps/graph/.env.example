GRAPH_PORT=3012
DATABASE_URL=postgresql://astro:astro@localhost:5434/astro
# same secret as apps/api — the graph service verifies Astro access tokens
JWT_ACCESS_SECRET=change-me-access
WEB_ORIGIN=http://localhost:3010
# one key, or several comma-separated (rotated on rate limits)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
QDRANT_URL=http://localhost:6333
